{
  "markdown": {},
  "toml": { "indentWidth": 4 },
  "json": {},
  "yaml": {},
  "exec": {
    "cwd": "${configDir}",
    // `cargo fmt` formats the workspace's Rust code, with each crate's edition. cheadergen's UI test
    // fixtures aren't workspace members, so dprint formats its Rust code, as it did before the move.
    "commands": [
      {
        "command": "rustfmt --edition 2024",
        "associations": ["cheadergen/**/*.rs"],
        "cacheKeyFiles": ["rust-toolchain.toml"]
      }
    ]
  },
  "excludes": [
    "**/target",
    "**/Cargo.lock",
    // Generated from the crate docs by `cargo rdme`, which CI checks.
    "biscotti/README.md",
    "tracing_log_error/README.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.26.0.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/exec-0.8.0.json@1f2dfbf5dec6d2e590b2c8b0ba6dbfaf80d0320fa9bd4c3f4f29efb99cd2bd6f"
  ]
}
